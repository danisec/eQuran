{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev --prefix frontend -- --host 127.0.0.1",
      "cwd": "../../"
    },
    "beforeBuildCommand": {
      "script": "node scripts/build-frontend.mjs",
      "cwd": "../../"
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../tts/requirements.txt": "tts/requirements.txt",
      "../../tts/setup.ps1": "tts/setup.ps1",
      "../../tts/python/": "tts/python/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
