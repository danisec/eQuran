{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../frontend -- --host 127.0.0.1",
    "beforeBuildCommand": "node ../../scripts/build-frontend.mjs"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../tts/requirements.txt": "tts/requirements.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
